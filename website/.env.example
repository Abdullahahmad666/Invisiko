# Copy to .env.local for local development. Never commit real values.

# --- Public facts (inlined into the page at build time; safe to expose) -----------------------
# Optional overrides. Confirmed facts (name, invisiko.app, support@invisiko.app, a 24–48 hour reply)
# are already the defaults in content/site.ts; the rest fall back to a visible [[PLACEHOLDER]].
NEXT_PUBLIC_SITE_URL=https://invisiko.app
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_REPLY_TIME=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_APP_STORE_URL=

# --- Contact form: the support@invisiko.app mailbox over SMTP (server-only; never NEXT_PUBLIC_) ---
# Until host, user and password are set, /api/contact answers 503 and the form offers the address.
# Examples: Google Workspace smtp.gmail.com · Microsoft 365 smtp.office365.com · Zoho smtp.zoho.eu
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS)
SMTP_PORT=587
SMTP_USER=support@invisiko.app
# Often an app password, where the mailbox has two-factor sign-in.
SMTP_PASS=
# Optional: default to SMTP_USER and "Invisiko <SMTP_USER>".
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=


# --- Search engines (set once the canonical domain is live) -----------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
