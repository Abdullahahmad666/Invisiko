# Copy to .env.local for local development. Never commit real values.

# --- Public facts (inlined into the page at build time; safe to expose) -----------------------
# Each falls back to a visible [[PLACEHOLDER]] until set. See PRODUCT_BLUEPRINT.md §14.
NEXT_PUBLIC_SITE_URL=https://invisiko.app
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_REPLY_TIME=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
NEXT_PUBLIC_APP_PRIVACY_URL=
NEXT_PUBLIC_APP_SUPPORT_URL=

# --- Contact form (server-only secrets; never prefix with NEXT_PUBLIC_) ----------------------
# Until all three are set, /api/contact answers 503 and the form offers the email address instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Search engines (set once the canonical domain is live) -----------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
